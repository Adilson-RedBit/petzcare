# =============================================================
# Variáveis de ambiente — PetCare Agenda
# Copie para .env.local (NÃO commitar) e preencha os valores reais.
# =============================================================

# OBRIGATÓRIO em todos os ambientes. Mínimo 32 caracteres.
# Gerar com: openssl rand -hex 32
JWT_SECRET=

# Cloudflare API Token (para deploy via wrangler)
CLOUDFLARE_API_TOKEN=

# CSV de origens permitidas no CORS do worker (separar por vírgula).
# Default em produção: https://petzcare.org,https://www.petzcare.org
ALLOWED_ORIGINS=https://petzcare.org,https://www.petzcare.org,http://localhost:3000,http://localhost:5173

# Ambiente (defina como "production" em prod).
NODE_ENV=development

# URL do worker em dev (usada pelas rotas proxy do Next legado).
# Em prod, o worker é acessado via Pages Functions e não precisa.
WORKER_URL=http://localhost:8787
